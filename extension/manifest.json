{
  "manifest_version": 3,
  "name": "Apex Capital - SteamDB AI Stock Recommender",
  "version": "1.0.0",
  "description": "SteamDB-style AI multi-expert stock recommendation engine. Blue for Best, Green for OK, Red for Worst.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Apex Capital - SteamDB Stock Ratings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.finance.yahoo.com/*",
        "*://finance.yahoo.com/*",
        "*://*.google.com/finance*",
        "*://*.bloomberg.com/*",
        "*://*.reddit.com/*",
        "*://*.twitter.com/*",
        "*://*.x.com/*",
        "*://*.cnbc.com/*",
        "*://*.marketwatch.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
